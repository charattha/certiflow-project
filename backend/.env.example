# ============================================================
# Supabase Database — get these from your Supabase project:
# Dashboard → Project Settings → Database → Connection string
# ============================================================

# Pooled connection (Transaction mode, port 6543) — used at RUNTIME by Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used for Prisma MIGRATIONS only
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============================================================
# Auth
# ============================================================

# JWT secret — MUST be set. Generate with: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ============================================================
# Server
# ============================================================

# Railway/Render sets PORT automatically — leave as default
PORT=3001

# Node environment
NODE_ENV="production"

# ============================================================
# CORS — set to your Cloudflare Pages URL(s)
# Comma-separated if multiple (e.g. preview + production URLs)
# ============================================================
FRONTEND_URL="https://certiflow.pages.dev"
