# Docker-specific environment variables
# Copy this to .env.docker and fill in your values

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=certiflow

# Backend
DATABASE_URL="postgresql://postgres:CHANGE_ME_TO_STRONG_PASSWORD@db:5432/certiflow"
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
PORT=3001
FRONTEND_URL="http://localhost"
NODE_ENV="production"
